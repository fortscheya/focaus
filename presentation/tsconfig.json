{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["components/**/*.ts", "composables/**/*.ts", "data/**/*.ts", "playwright.config.ts", "tests/**/*.ts"]
}
